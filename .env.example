# ==============================================================================
# Rural Innovation Hub - Environment Variables
# ==============================================================================

# Database (MySQL 8.0)
DATABASE_URL=mysql+pymysql://hub_user:hub_password@localhost:3306/rural_innovation_hub

# Security & JWT
JWT_SECRET=super-secret-rural-innovation-jwt-key-2026-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Settings
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/api/ws
VITE_APP_TITLE=Rural Innovation Hub
VITE_ENABLE_DEMO_LOGIN=true
